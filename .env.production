# Production environment variables
# Ensure secure secrets, do NOT commit real values to source control
LOCAL_PORT=3001
MONGOBD_USER=your_prod_user
MONGOBD_PASSWORD=your_prod_password
NODE_ENV=production
SESSION_SECRET=your_session_secret
TOKEN_SECRET=your_strong_token_secret
TOKEN_REFRESH=refreshtoken
TOKEN_EXP_IN=3h
REDIS_URL=redis://your_redis_host:6379
