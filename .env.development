# Environment Configuration
# Copy this file to .env and fill in your values

# Node Environment
NODE_ENV=development

# Server Port
LOCAL_PORT=3001

# MongoDB Connection
# Option 1: Full connection string (recommended)
# MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/resume-api?retryWrites=true&w=majority

# Option 2: Individual credentials (fallback - for backward compatibility)
MONGOBD_USER=
MONGOBD_PASSWORD=

# Session Configuration
SESSION_SECRET=your-session-secret-change-in-development

# JWT Configuration
TOKEN_SECRET=your-jwt-secret-change-in-development
TOKEN_REFRESH=your-refresh-token-secret-change-in-development
TOKEN_EXP_IN=7d


